{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "config.wsgi:application"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": { "service": "backend" } },
    { "source": "/admin/:path*", "destination": { "service": "backend" } },
    { "source": "/static/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
